# Image for the installer test (install-test.sh): a bare Ubuntu with a non-root user that has passwordless sudo.
# No uv, no tmux, no git, no ps, no lsof on purpose: install.sh has to bring them. Build context = `git archive` of the repo.
FROM ubuntu:26.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends sudo curl ca-certificates locales \
 && apt-get purge -y procps \
 && locale-gen en_US.UTF-8 \
 && rm -rf /var/lib/apt/lists/*
RUN useradd -m -s /bin/bash tester && echo 'tester ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/tester
COPY scripts/linux-smoke/fake-bin/ /usr/local/fake-bin/
USER tester
ENV HOME=/home/tester LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 TERM=xterm-256color
COPY --chown=tester:tester . /home/tester/src
WORKDIR /home/tester/src
